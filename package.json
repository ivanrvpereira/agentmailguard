{
  "name": "agentmailguard",
  "version": "1.0.0",
  "description": "Cloudflare-native email gateway for AI agents.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "cf-typegen": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply agentmail --local",
    "db:migrate:remote": "wrangler d1 migrations apply agentmail --remote",
    "dev:sender": "npm run dev --prefix workers/email-sender",
    "deploy:sender": "npm run deploy --prefix workers/email-sender"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "agents": "^0.12.0",
    "postal-mime": "^2.7.4",
    "zod": "^4.4.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260501.1",
    "typescript": "^6.0.3",
    "wrangler": "^4.87.0"
  }
}
